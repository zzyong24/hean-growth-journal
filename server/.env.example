PORT=8787
HOST=127.0.0.1
DUDU_BASE_URL=https://dudu.mom/v1
DUDU_API_KEY=
DUDU_MODEL=gpt-5.6-sol
# Independent text / image-understanding fallback. Never include these in mobile env.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
# Set qwen with QWEN_TEXT_MODEL to use direct DashScope + MiniMax, bypassing DUDU.
AI_PRIMARY_PROVIDER=minimax
DASHSCOPE_API_KEY=
DASHSCOPE_COMPATIBLE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Explicit opt-in; leave empty to retain the legacy text provider.
QWEN_TEXT_MODEL=
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_OMNI_MODEL=qwen3.5-omni-plus
# For LAN access: HOST=0.0.0.0 and a random APP_TOKEN; set the same token in mobile env.
APP_TOKEN=

# Optional, separate opt-in for multimodal observation; ASR key alone does not enable it.
QWEN_OMNI_API_KEY=

# Independent image creation channel, server only
DUDU_IMAGE_API_KEY=
DUDU_IMAGE_MODEL=gpt-image-2

# Optional gateway + assistant sync: npm run gateway (localhost reverse proxy only).
# Use your own HTTPS origin. Must match the Agent's configure.py --origin.
PUBLIC_ORIGIN=https://hean.example.com
STATE_DIRECTORY=./state
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
